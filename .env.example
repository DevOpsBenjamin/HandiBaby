# Copy to .env.local and fill in. Leave empty to run fully offline on IndexedDB.
# The anon key is public by design: every write goes through a SECURITY DEFINER
# RPC that checks the organiser passphrase, so nothing here grants write access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Milliseconds between automatic pulls while the tab is visible.
VITE_SYNC_POLL_INTERVAL_MS=5000
